
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key

# Confidence threshold used when an organization has configured no policy
DEFAULT_CONFIDENCE_THRESHOLD=0.75

# Phase 4 (both optional: if unset, only those features report "not configured")
# Supabase JWT secret: Project Settings -> API (or JWT Keys). Signs the
# short-lived Realtime tokens.
SUPABASE_JWT_SECRET=
# A random secret you invent; your cron service sends it as X-Internal-Secret.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_CRON_SECRET=



# Phase 5, the LLM judge (optional: with no key the judge is simply unavailable)
# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model that reviews sampled decisions (defaults to gemini-3.5-flash-lite)
JUDGE_MODEL=



# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Defaults to the production dashboard and localhost:3000 when unset.
CORS_ALLOWED_ORIGINS=
